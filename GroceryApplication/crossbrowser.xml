<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="crossbrowser Testing">


  <test thread-count="5" name="chrome Test">
  <parameter name="browsers" value="chrome"></parameter>
    <classes>
      <class name="testScript.LoginTest">
      <methods>
      <include name="verifyUserLoginWithInvalidUserNameValidPassword">
      </include>
      </methods>
      </class>
    </classes>
  </test> <!-- Test -->
  
  
  <test thread-count="5" name="FireFox Test">
  <parameter name="browsers" value="firefox"></parameter>
    <classes>
      <class name="testScript.LoginTest">
      <methods> 
     <include name="verifyUserLoginWithInvalidUserNameValidPassword">
     </include>
     
     </methods>
      </class>
    </classes>
  </test> <!-- Test -->
  
  <test thread-count="5" name="Edge Test">
  <parameter name="browsers" value="Edge"></parameter>
    <classes>
      <class name="testScript.LoginTest">
      <methods>
      <include name="verifyUserLoginWithInvalidUserNameValidPassword">
      </include>
      </methods>
      </class>
    </classes>
  </test> <!-- Test -->
</suite> <!-- Suite -->
